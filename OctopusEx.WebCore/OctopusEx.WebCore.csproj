<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <AssemblyName>OctopusEx.WebCore</AssemblyName>
    <AssemblyTitle>Octopus核心库</AssemblyTitle>
    <Description>Web核心基础组件，公共类。</Description>
    <Company>Fatty Coder</Company>
    <Copyright>©2024-2026 Fatty Coder</Copyright>
    <VersionPrefix>1.5</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</AssemblyVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 程序集签名配置 -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../octopus-key.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
  </PropertyGroup>

  <!-- NuGet 包元数据 -->


  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <RepositoryUrl>https://github.com/Fat-Snail/OctopusUtils</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Octopus核心库;$(AssemblyName)</PackageTags>
    <PackageIcon>favicon.png</PackageIcon>
    <PackageReleaseNotes>v1.5.5：新增模块健康检查、Octopus 诊断端点、多租户 Hangfire Dashboard、Outbox 与幂等性持久化能力，并完善 CRUD、审计和敏感词过滤。</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\favicon.png" Link="favicon.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Mapster" Version="10.0.14" />
    <!-- Source Generator 集成：Mapster.Tool 是 dotnet CLI 工具（不是 NuGet 库）。
         运行 `dotnet tool install -g Mapster.Tool` 后通过 `dotnet mapster model -a <asm>`
         编译期生成映射代码，运行时无反射开销。详见 Mapster 文档。 -->
    <!-- ASP.NET Core / EF Core 家族：11.x 只提供 net11.0 资产，net10.0 目标停留在 10.0.15 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.SemanticKernel.Core" Version="1.82.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenTelemetry" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.21.0" />
    <!-- Swashbuckle 11 依赖 Microsoft.OpenApi 3.x，而 net10.0 上的
         Microsoft.AspNetCore.OpenApi 10.0.15 锁在 Microsoft.OpenApi 2.x，
         两者不共存，因此按 TFM 分别引用。 -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="ToolGood.Words" Version="3.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\favicon.png">
      <Link>favicon.png</Link>
      <PackagePath>/</PackagePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DomainCore\Abstractions\Interfaces\DataAccess\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Octopus.Tools\Octopus.Tools.csproj" />
  </ItemGroup>

</Project>
